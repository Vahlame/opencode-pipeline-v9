# Entorno
NODE_ENV=development

# Runtime de OpenCode: http | sdk | mock
OPENCODE_RUNTIME=http

# Servidor V2 de la app o dedicado. Si se omite, se descubre el servicio local.
OPENCODE_BASE_URL=
OPENCODE_PASSWORD=

# Agente y modelo. OpenCode Go con DeepSeek V4.1 Flash y tools.
OPENCODE_AGENT=padre
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash

# Directorio del proyecto que vera OpenCode.
OPENCODE_PROJECT_DIR=.

# Pruebas reales: 0 por defecto para no consumir tokens en CI.
OPENCODE_REAL_TESTS=0
OPENCODE_KEEP_SESSION=0

# SDK en modo headless (solo pruebas)
OPENCODE_SDK_DATA_DIR=

# Nucleo persistente
ORCH_DB_PATH=.runtime/orchestrator.db
ORCH_AUTH_SECRET=replace-with-a-random-secret-at-least-16-chars
ORCH_TOOL_SECRET=replace-with-another-random-secret-at-least-16-chars
ORCH_TOOL_API_URL=http://127.0.0.1:4400
ORCH_API_HOST=127.0.0.1
ORCH_API_PORT=4400

# Ejecucion
ORCH_MAX_PARALLEL=2
ORCH_MAX_AGENTS=2
ORCH_LEASE_SECONDS=60
ORCH_HEARTBEAT_SECONDS=15
ORCH_SESSION_TIMEOUT_MS=300000
ORCH_TASK_MAX_ATTEMPTS=3
ORCH_WORKTREE_ROOT=.worktrees
ORCH_AGENT_MODEL=opencode-go/deepseek-v4.1-flash
ORCH_GIT_BASE_REF=HEAD
ORCH_MAX_REWORK_CYCLES=2
ORCH_JURY_TIMEOUT_MS=180000
ORCH_INTEGRATION_TIMEOUT_MS=300000
ORCH_FEEDBACK_TIMEOUT_MS=300000

# Fase 6: recursos, recuperacion y mantenimiento
ORCH_MAX_INTEGRATION_ATTEMPTS=5
ORCH_PROJECT_MAX_MINUTES=120
ORCH_MAX_PROJECT_TOKENS=2000000
ORCH_MAX_PROJECT_COST_USD=25
ORCH_INPUT_COST_PER_MILLION=0.15
ORCH_OUTPUT_COST_PER_MILLION=0.6
ORCH_RECOVERY_STALE_MINUTES=10
ORCH_RECOVERY_ON_START=1
ORCH_WORKTREE_RETENTION_DAYS=7
ORCH_OPERATION_LEASE_SECONDS=300
