{
  "name": "opencode-multiagent-orchestrator-v9",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Orquestador multiagente sobre OpenCode V2",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "cross-env OPENCODE_REAL_TESTS=1 vitest run tests/e2e/opencode-real.test.ts",
    "test:sdk": "cross-env OPENCODE_SDK_TESTS=1 vitest run tests/integration/sdk-adapter.test.ts",
    "doctor": "tsx src/cli.ts doctor",
    "agents": "tsx src/cli.ts agents",
    "smoke": "tsx src/cli.ts smoke",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "serve": "tsx src/cli.ts serve",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@opencode/client": "^2.2.5",
    "@opencode/sdk": "^2.2.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "effect": "^4.0.6",
    "solid-js": "^1.9.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
