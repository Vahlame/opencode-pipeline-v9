# Entorno
NODE_ENV=development

# Runtime de OpenCode: http | sdk | mock
OPENCODE_RUNTIME=http

# Servidor V2 dedicado. Si se omite, se descubre el servicio local de la app.
OPENCODE_BASE_URL=
OPENCODE_PASSWORD=

# Agente y modelo para el smoke real.
# El modelo por defecto de OpenCode puede no soportar tools; usa uno con capabilities.tools=true.
# Este modelo gratuito funcionó en la verificación local.
OPENCODE_AGENT=padre
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# Directorio del proyecto que verá OpenCode.
OPENCODE_PROJECT_DIR=.

# Pruebas reales: 0 por defecto para no consumir tokens en CI.
OPENCODE_REAL_TESTS=0
OPENCODE_KEEP_SESSION=0

# SDK en modo headless (solo pruebas)
OPENCODE_SDK_DATA_DIR=

# Núcleo persistente de la Fase 2
ORCH_DB_PATH=.runtime/orchestrator.db
ORCH_AUTH_SECRET=replace-with-a-random-secret-at-least-16-chars
ORCH_API_HOST=127.0.0.1
ORCH_API_PORT=4400

# Fase 3: ejecución
ORCH_MAX_PARALLEL=2
ORCH_LEASE_SECONDS=60
ORCH_HEARTBEAT_SECONDS=15
ORCH_SESSION_TIMEOUT_MS=300000
ORCH_TASK_MAX_ATTEMPTS=3
ORCH_WORKTREE_ROOT=.worktrees
# "DeepSeek V4.1 Flash Max" no aparece en el catálogo local; el modelo de pago
# puede fallar si la cuenta no tiene fondos. Este modelo gratuito soporta tools.
ORCH_AGENT_MODEL=opencode/deepseek-v4.1-flash-free
ORCH_GIT_BASE_REF=HEAD
