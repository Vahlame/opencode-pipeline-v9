# Entorno
NODE_ENV=development

# Runtime de OpenCode: http | sdk | mock
OPENCODE_RUNTIME=http

# Servidor V2 dedicado. Si se omite, se descubre el servicio local de la app.
OPENCODE_BASE_URL=
OPENCODE_PASSWORD=

# Agente y modelo para el smoke real.
# El modelo por defecto de OpenCode puede no soportar tools; usa uno con capabilities.tools=true.
# Este modelo gratuito funcionó en la verificación local.
OPENCODE_AGENT=padre
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# Directorio del proyecto que verá OpenCode.
OPENCODE_PROJECT_DIR=.

# Pruebas reales: 0 por defecto para no consumir tokens en CI.
OPENCODE_REAL_TESTS=0
OPENCODE_KEEP_SESSION=0

# SDK en modo headless (solo pruebas)
OPENCODE_SDK_DATA_DIR=
